# Copy to ~/.config/tmedia/.env or ~/.tmedia.env and fill in once.
# tmedia discovers these automatically - no prompt, no new login on any PC.
# Get the values from https://my.telegram.org -> API development tools.
#
# NEVER commit a filled-in version of this file.

TMEDIA_API_ID=12345678
TMEDIA_API_HASH=0123456789abcdef0123456789abcdef
TMEDIA_PHONE=+8801XXXXXXXXX

# Optional path overrides (useful on Termux / Windows / portable setups)
# TMEDIA_CONFIG_DIR=/home/you/.config/tmedia
# TMEDIA_DOWNLOAD_DIR=/home/you/Downloads
